# SmartCity360 environment configuration template
# Replace placeholders with your own local configuration.
# Never commit actual credentials.

SMARTCITY_DB_URL=jdbc:mysql://localhost:3306/smartcity360_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

SMARTCITY_DB_USERNAME=smartcity360_app

SMARTCITY_DB_PASSWORD=CHANGE_THIS_TO_YOUR_LOCAL_PASSWORD

SMARTCITY_AES_KEY=GENERATE_A_BASE64_ENCODED_32_BYTE_KEY